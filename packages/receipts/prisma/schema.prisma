// Datastore for the receipt importer (see costco-receipt-importer.md).
// SQLite via Prisma 7's prisma-client generator. Amounts are Float (SQLite
// REAL) — the reconcile() tolerance absorbs float noise; item/receipt money
// is low-stakes for a personal tool. Store/payer/splits are modeled
// relationally (rows, not columns) so a new store or a third participant is
// a data change, not a migration.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "sqlite"
}

model Participant {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  active Boolean @default(true)

  splitDefaults ItemSplitDefault[]
  lineSplits    LineItemSplit[]
  paidReceipts  Receipt[]
}

model Store {
  id   Int    @id @default(autoincrement())
  name String @unique

  items    Item[]
  receipts Receipt[]
}

model Item {
  id             Int      @id @default(autoincrement())
  storeId        Int
  itemCode       String?
  normalizedName String?
  displayName    String?
  lastSeenName   String
  createdAt      DateTime @default(now())

  store             Store              @relation(fields: [storeId], references: [id])
  splitDefaults     ItemSplitDefault[]
  priceObservations PriceObservation[]
  lineItems         LineItem[]

  // Item-code match is preferred; normalizedName is the per-store fallback.
  // Both are nullable so a line the model couldn't read a code or name for
  // at all never collides with another equally-unidentifiable line — SQL
  // treats every NULL as distinct under a unique index, unlike two equal
  // empty strings, which previously merged unrelated items together.
  @@unique([storeId, itemCode])
  @@unique([storeId, normalizedName])
}

model ItemSplitDefault {
  id            Int   @id @default(autoincrement())
  itemId        Int
  participantId Int
  percent       Float

  item        Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id])

  @@unique([itemId, participantId])
}

model PriceObservation {
  id             Int      @id @default(autoincrement())
  itemId         Int
  receiptId      Int
  unitPrice      Float
  quantity       Float
  discountAmount Float    @default(0)
  observedAt     DateTime

  item    Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

enum ReceiptStatus {
  // Placeholder row created immediately on upload, before extraction runs.
  QUEUED
  // Set while the upload queue's worker is actively extracting this one.
  EXTRACTING
  EXTRACTED
  // A thrown extraction error (not a failed reconciliation, which still
  // lands on EXTRACTED with reconciled: false) — see extractionError below.
  FAILED
  // The user deliberately stopped a QUEUED/EXTRACTING receipt, distinct from
  // FAILED (extraction erroring out on its own). See docs/adr/0002.
  CANCELLED
  SUBMITTED
}

model Receipt {
  id               Int           @id @default(autoincrement())
  storeId          Int
  payerId          Int
  sourceSha256     String        @unique
  sourcePath       String
  // The uploaded file's own name, captured at enqueue time so a
  // QUEUED/EXTRACTING/FAILED row has something meaningful to show before
  // extraction has run. Never overwritten afterward. Nullable since rows
  // ingested before this field existed don't have one.
  originalFilename String?
  // Unknown until extraction succeeds — null for a QUEUED/EXTRACTING/FAILED row.
  purchaseDate     DateTime?
  subtotal         Float?
  tax              Float?
  total            Float?
  // Portion of `total` actually charged to a card — the amount that will
  // match a Citi CSV transaction. Differs from `total` when a purchase was
  // split across tender types (e.g. partly cash or Costco Cash Rewards).
  // Null only for receipts ingested before this field existed, or not yet
  // extracted; ingest.ts always populates it once extraction succeeds
  // (falling back to `total` when no tender breakdown was extracted).
  cardAmount       Float?
  status           ReceiptStatus @default(QUEUED)
  // Set when the review UI (Phase 3) transitions this receipt to SUBMITTED.
  submittedAt      DateTime?
  reconciled       Boolean       @default(false)
  // The full ReconcileResult (reconcile.ts) as JSON — same "JSON as a String
  // column" convention as periodResultsJson/columnMappingJson elsewhere in
  // this schema. Lets the review UI name the specific mismatch (e.g. "total
  // is $4.37 higher than line items + tax") instead of just a boolean. Null
  // for a receipt ingested before this field existed, or not yet extracted.
  reconcileJson    String?
  createdAt        DateTime      @default(now())
  // The last extraction attempt's error message — set only when status is
  // FAILED, cleared when the row is requeued for retry.
  extractionError  String?

  store             Store              @relation(fields: [storeId], references: [id])
  payer             Participant        @relation(fields: [payerId], references: [id])
  lineItems         LineItem[]
  priceObservations PriceObservation[]
  tenders           ReceiptTender[]

  @@index([status, createdAt])
}

// One row per payment line on the receipt footer (card, cash, Costco Cash
// Reward, etc.) — never the card/account number itself, only how much was
// tendered by which method. See extractReceipt.ts's tenderSchema for the
// "kind" values the extractor is constrained to.
model ReceiptTender {
  id        Int    @id @default(autoincrement())
  receiptId Int
  kind      String
  label     String
  amount    Float

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

model LineItem {
  id             Int     @id @default(autoincrement())
  receiptId      Int
  itemId         Int?
  rawItemCode    String?
  rawName        String
  unitPrice      Float
  quantity       Float
  lineTotal      Float
  discountAmount Float   @default(0)
  reviewed       Boolean @default(false)

  receipt Receipt         @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  item    Item?           @relation(fields: [itemId], references: [id])
  splits  LineItemSplit[]
}

model LineItemSplit {
  id            Int   @id @default(autoincrement())
  lineItemId    Int
  participantId Int
  percent       Float

  lineItem    LineItem    @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id])

  @@unique([lineItemId, participantId])
}

// DB-backed replacement for CsvConverterFactory's hardcoded
// defaultPersonalExclusions (packages/core/src/csvConverterFactory.ts) —
// seeded once from those values by the add_csv_rule_tables migration, then
// authoritative from both packages/automation's CLI sync and
// packages/receipt-review's UI import flow. `payer` is stored uppercased,
// matching CsvConverterFactory.isValidLine's `name.toUpperCase()` lookup.
model PayerExclusionRule {
  id        Int      @id @default(autoincrement())
  payer     String
  pattern   String
  note      String?
  createdAt DateTime @default(now())

  @@unique([payer, pattern])
  @@index([payer])
}

// DB-backed replacement for CsvConverterFactory's hardcoded
// defaultSplitRulesDict.VARIABLE vendor list — same seeding story as
// PayerExclusionRule above. splitRulesDict.SHARED is deliberately NOT
// ported here: it's never read by isVariableSplit (ordinary/joint-bill
// transactions already default to the same "Equally" bucket), so an
// editable DB row for it would misleadingly imply it affects behavior.
model VariableSplitRule {
  id        Int      @id @default(autoincrement())
  pattern   String   @unique
  note      String?
  createdAt DateTime @default(now())
}

// Staged rows from a Citi CSV import (packages/receipt-review's UI-driven
// pipeline — see costco-receipt-importer.md's "Web UI: staged CSV import"
// plan). Not used by packages/automation's CLI sync, which tracks state via
// a separate date-based sync-state file instead.
model ImportedTransaction {
  id              Int       @id @default(autoincrement())
  payer           String
  // Raw MM/DD/YYYY, same convention as TransactionRow throughout the
  // codebase — never a parsed DateTime, to avoid timezone pitfalls and stay
  // consistent with core/automation's string-date handling.
  date            String
  description     String
  amount          Float
  splitType       String
  excluded        Boolean   @default(false)
  exclusionReason String?
  createdAt       DateTime  @default(now())
  syncedAt        DateTime?
  syncRunId       Int?
  // Set when the review UI soft-deletes this staged row (distinct from
  // `excluded`, which is set once at import time by the personal-exclusion
  // rules). Kept visible in the review table rather than hard-deleted, for
  // audit-trail consistency with excluded rows. Never set once syncedAt is
  // set — the sheet already reflects the prior value.
  removedAt       DateTime?

  syncRun CsvSyncRun? @relation(fields: [syncRunId], references: [id])

  importBatchId Int?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])

  // Re-importing an overlapping CSV export is idempotent: the same
  // real-world transaction (by payer/date/description/amount) is only ever
  // staged once, regardless of exclusion.
  @@unique([payer, date, description, amount])
}

// One row per CSV import run (packages/receipt-review's Import tab) — the
// grouping unit for the Review Transactions page's batch picker. Distinct
// from CsvSyncRun, which tracks *sync-to-Sheets* runs, set later and
// possibly spanning transactions from several import batches.
model ImportBatch {
  id                    Int      @id @default(autoincrement())
  // Auto-generated at import time from payer + transaction date range,
  // user-editable afterward from the Review Transactions page.
  title                 String
  // Free-text notes, user-editable, e.g. "remember to also pull the July
  // return credit next time."
  description           String?
  payer                 String
  // Raw MM/DD/YYYY, same convention as ImportedTransaction.date — the
  // min/max transaction date actually found among this batch's imported
  // rows, auto-computed at import time, never user-entered.
  minDate               String
  maxDate               String
  sourceFilename        String
  csvImportProfileId    Int?
  createdAt             DateTime @default(now())
  // Snapshot of the import result, so the picker/summary UI doesn't need to
  // re-query transaction counts per batch.
  importedCount         Int
  skippedDuplicateCount Int
  excludedCount         Int

  csvImportProfile CsvImportProfile?     @relation(fields: [csvImportProfileId], references: [id])
  transactions     ImportedTransaction[]
}

enum CsvSyncRunStatus {
  DONE // every tab succeeded
  PARTIAL // some tabs succeeded, some failed
  ERROR // failed before any tab was attempted (e.g. no saved OAuth token)
}

// A saved column-mapping for importing a non-Citi-shaped CSV (see
// packages/core's CsvColumnMapping) — created via the receipt-review UI's
// configurator the first time a new CSV shape is seen, then auto-detected
// on future imports of the same shape via headerSignature (a strong
// signal) or hasHeader+columnCount (a weaker fallback for headerless
// CSVs). columnMappingJson mirrors core's CsvColumnMapping shape as JSON —
// receipts is a foundational leaf and can't import core's type directly
// (see csvImportProfiles.ts's independently-declared zod schema).
model CsvImportProfile {
  id                Int       @id @default(autoincrement())
  name              String    @unique
  hasHeader         Boolean
  columnCount       Int
  headerSignature   String?
  columnMappingJson String
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime?

  importBatches ImportBatch[]

  @@index([headerSignature])
  @@index([hasHeader, columnCount])
}

model CsvSyncRun {
  id                Int              @id @default(autoincrement())
  createdAt         DateTime         @default(now())
  status            CsvSyncRunStatus
  // JSON: { payerName, periodLabel, rowCount, status: 'SYNCED'|'FAILED', errorMessage? }[]
  periodResultsJson String
  // Set only for a pre-flight failure (e.g. no saved OAuth token) that
  // happened before any period could be attempted — status ERROR, empty
  // periodResultsJson.
  errorMessage      String?

  transactions ImportedTransaction[]
}
