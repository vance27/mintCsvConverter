{
    "compilerOptions": {
        "target": "ES2021",
        "module": "ES2022",
        "moduleResolution": "Bundler",
        "lib": ["ES2021"],
        "strict": true,
        "types": ["google-apps-script", "node"],
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true
    },
    "include": ["src"]
}
