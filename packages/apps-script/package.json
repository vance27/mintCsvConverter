{
  "name": "@mint-csv-converter/apps-script",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rollup -c && cp appsscript.json dist/appsscript.json",
    "typecheck": "tsc --noEmit",
