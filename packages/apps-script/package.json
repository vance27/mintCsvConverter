    "deploy": "pnpm build && clasp push"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/google-apps-script": "2.0.11",
    "@types/node": "26.1.1",
    "rollup": "4.62.2",
    "tsx": "4.23.1",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "tslib": "2.8.1"
  }
}
