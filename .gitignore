.DS_STORE

# Python
*.pyc

# CSV Transaction Files
*.csv
*.CSV

.env

# Node
node_modules/
dist/
*.tsbuildinfo

# SQLite datastore (receipts) — working DB is local-only.
*.db
*.db-journal

# DB snapshot backup — local-only, not committed.
packages/receipts/data/

# Generated Prisma client (regenerated from schema via `prisma generate`)
packages/receipts/src/generated/

# clasp (Apps Script) — contains the script ID, kept local-only
.clasp.json

# Playwright e2e (packages/receipt-review) — its own isolated DB and run output
packages/receipt-review/e2e/.tmp/
packages/receipt-review/playwright-report/
packages/receipt-review/test-results/

# Editor
.vscode/


.nx/cache
.nx/workspace-data
.nx/migrate-runs
.nx/polygraph
.claude/worktrees
.claude/settings.local.json
vitest.config.*.timestamp*